<AnchorPane prefHeight="300.0" prefWidth="225.0" stylesheets="@../Estilo/Estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="EDGJ.Controle.CardC">
   <children>
      <Pane prefHeight="300.0" prefWidth="233.0" styleClass="painel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label id="nome" fx:id="nome" layoutX="21.0" layoutY="182.0" prefHeight="17.0" prefWidth="169.0" styleClass="subtitulo" text="nome" textFill="WHITE">
